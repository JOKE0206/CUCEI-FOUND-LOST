# Copia este archivo como backend/.env y reemplaza los valores.
# Nunca subas backend/.env a GitHub.

# Puerto del servidor Express
PORT=4000

# Origen del frontend permitido por CORS
FRONTEND_URL=http://localhost:3000

# Supabase: Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave service_role: tiene acceso total y omite RLS.
# Solo se usa en el backend; jamás en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
